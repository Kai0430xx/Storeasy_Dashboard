rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function globalAccess() {
      return activeUser()
        && profile().role in ['admin', 'supervisor'];
    }

    function branchAccess(id) {
      return globalAccess()
        || (
          activeUser()
          && profile().role in ['manager', 'employee']
          && id in profile().branchIds
        );
    }

    function branchEdit(id) {
      return globalAccess()
        || (
          activeUser()
          && profile().role == 'manager'
          && id in profile().branchIds
        );
    }

    function unlocked(id) {
      return !(
        'importing' in get(
          /databases/$(database)/documents/branches/$(id)
        ).data
      );
    }

    function ownImport(id) {
      let b = get(
        /databases/$(database)/documents/branches/$(id)
      ).data;

      return 'importing' in b
        && b.importing.by == request.auth.uid;
    }

    function positive(n) {
      return n is number && n >= 0;
    }

    function optionalCount(d, k) {
      return !(k in d)
        || d[k] == null
        || (d[k] is int && d[k] >= 0);
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || globalAccess()
        );

      allow create: if signedIn() && !exists(/databases/$(database)/documents/deletedUsers/$(uid))
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'username',
          'role',
          'branchIds',
          'mustChangePassword',
          'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.matches(
          '[a-zA-Z0-9_-]{2,32}'
        )
        && request.auth.token.email
          == request.resource.data.username.lower()
            + '@accounts.storeasy.invalid'
        && request.resource.data.role == 'pending'
        && request.resource.data.branchIds == []
        && request.resource.data.mustChangePassword is bool
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && (
          (
            uid == request.auth.uid
            && request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              'mustChangePassword'
            ])
            && request.resource.data.mustChangePassword == false
          )
          || (
            uid != request.auth.uid
            && globalAccess()
            && (
              profile().role == 'admin'
              || (
                !(resource.data.role in [
                  'admin', 'supervisor'
                ])
                && !(request.resource.data.role in [
                  'admin', 'supervisor'
                ])
              )
            )
            && request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              'role',
              'branchIds',
              'updatedBy',
              'updatedAt'
            ])
            && request.resource.data.role in [
              'admin',
              'supervisor',
              'manager',
              'employee',
              'pending'
            ]
            && request.resource.data.branchIds is list
            && request.resource.data.branchIds.size() <= 100
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if activeUser()
      && profile().role == 'admin'
      && uid != request.auth.uid
      && existsAfter(
        /databases/$(database)/documents/deletedUsers/$(uid)
      )
      && getAfter(
        /databases/$(database)/documents/deletedUsers/$(uid)
      ).data.deletedBy == request.auth.uid
      && getAfter(
        /databases/$(database)/documents/deletedUsers/$(uid)
      ).data.deletedAt == request.time;
    }


    match /deletedUsers/{uid} {
      allow read: if signedIn()
        && (uid == request.auth.uid || globalAccess());

      allow create: if activeUser()
        && profile().role == 'admin'
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'username', 'deletedBy', 'deletedAt'
        ])
        && request.resource.data.username == get(
          /databases/$(database)/documents/users/$(uid)
        ).data.username
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && !existsAfter(
          /databases/$(database)/documents/users/$(uid)
        );

      allow update, delete: if false;
    }

    match /branches/{id} {
      function validOpening() {
    let d=request.resource.data;
    return !('openingMonth' in d) || d.openingMonth == null
     || (d.openingMonth is string && d.openingMonth.matches('20[0-9]{2}-(0[1-9]|1[0-2])'));
   }
   function balanced() {
        let d = request.resource.data;

        return d.name is string
          && d.name.size() > 0
          && d.name.size() <= 80
          && d.total is int
          && d.rented is int
          && d.vacant is int
          && d.total >= 0
          && d.rented >= 0
          && d.vacant >= 0
          && d.total == d.rented + d.vacant
          && d.revision is int
          && d.revision >= 0;
      }

      allow read: if branchAccess(id);

      allow create: if globalAccess()
        && balanced() && validOpening()
        && request.resource.data.total == 0
        && request.resource.data.revision == 0;

      allow update: if branchEdit(id) && (globalAccess() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['openingMonth']))
        && balanced() && validOpening()
        && request.resource.data.revision >= resource.data.revision
        && (
          !('importing' in resource.data)
          || resource.data.importing.by == request.auth.uid
          || request.time.toMillis()
            - resource.data.importing.startedAt > 600000
        );

      allow delete: if false;

      match /units/{code} {
        function validUnit() {
          let u = request.resource.data;

          return (!('vacantSince' in u)
              || u.vacantSince == null
              || (u.status == 'vacant'
                && u.vacantSince is string
                && u.vacantSince.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && u.code == code
            && u.status in ['rented', 'vacant']
            && u.missing is bool
            && positive(u.volume)
            && positive(u.price)
            && positive(u.unitPrice)
            && u.note is string
            && u.note.size() <= 500
            && u.dimensions is string
            && u.dimensions.size() <= 100;
        }

        function eventMatches() {
          let u = request.resource.data;
          let e = getAfter(
            /databases/$(database)/documents/branches/$(id)/events/$(u.lastEventId)
          ).data;

          return e.code == code
            && e.createdBy == request.auth.uid
            && e.createdAt == request.time
            && !e.voided
            && (
              (
                e.type == 'new'
                && resource.data.status == 'vacant'
                && u.status == 'rented'
              )
              || (
                e.type == 'exit'
                && resource.data.status == 'rented'
                && u.status == 'vacant'
              )
            );
        }

        function undoMatches() {
          let e = getAfter(
            /databases/$(database)/documents/branches/$(id)/events/$(resource.data.lastEventId)
          ).data;

          return e.voided
            && e.voidedBy == request.auth.uid
            && e.voidedAt == request.time
            && request.resource.data.lastEventId
              == e.previousEventId
            && (
              (
                e.type == 'new'
                && request.resource.data.status == 'vacant'
              )
              || (
                e.type == 'exit'
                && request.resource.data.status == 'rented'
              )
            );
        }

        allow read: if branchAccess(id);

        allow create: if branchEdit(id)
          && validUnit()
          && (
            ownImport(id)
            || (
              unlocked(id)
              && request.resource.data.status == 'vacant'
              && request.resource.data.lastEventId == null
            )
          );

        allow update: if branchEdit(id)
          && validUnit()
          && (
            ownImport(id)
            || (
              unlocked(id)
              && (
                request.resource.data.status == resource.data.status
                || (request.resource.data.lastEventId != null && eventMatches())
                || (resource.data.lastEventId != null && undoMatches())
              )
            )
          );

        allow delete: if branchEdit(id)
          && unlocked(id)
          && resource.data.status == 'vacant';
      }

      match /events/{eventId} {
        function removesActivity() {
          let r = request.resource.data.activityRemoval;
          let lock = get(/databases/$(database)/documents/branches/$(id)).data.importing;
          let activity = get(/databases/$(database)/documents/branches/$(id)/activities/$(r.activity.id)).data;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activities','activityRemoval'])
            && request.resource.data.activities is list
            && resource.data.activities.hasAny([r.activity])
            && request.resource.data.activities == resource.data.activities.removeAll([r.activity])
            && r.by == request.auth.uid && r.at == request.time && r.token == lock.token
            && lock.operation == 'removeActivity' && lock.activityId == r.activity.id
            && activity.deleting == true && activity.archived == true && activity.updatedBy == request.auth.uid;
        }
        allow read: if branchAccess(id);

        allow create: if branchEdit(id)
          && unlocked(id)
          && (
            request.resource.data.type != 'exit'
            || (
              request.resource.data.exitCategory in [
                '價格', '距離', '不再需要',
                '改租其它倉位/據點', '服務或環境', '其它'
              ]
              && request.resource.data.exitReason is string
              && request.resource.data.exitReason.size() > 0
              && request.resource.data.exitReason.size() <= 500
            )
          )
          && request.resource.data.type in [
            'new', 'renew', 'exit'
          ]
          && request.resource.data.date is string
          && request.resource.data.date.matches(
            '[0-9]{4}-[0-9]{2}-[0-9]{2}'
          )
          && request.resource.data.month.matches(
            '[0-9]{4}-(0[1-9]|1[0-2])'
          )
          && request.resource.data.activities is list
          && request.resource.data.activities.size() <= 30
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.voided == false
          && getAfter(
            /databases/$(database)/documents/branches/$(id)/units/$(request.resource.data.code)
          ).data.lastEventId == eventId;

        allow update: if ((branchEdit(id)
          && unlocked(id)
          && !resource.data.voided
          && request.resource.data.voided
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly(['voided','voidedBy','voidedAt','voidMode']) && (!('voidMode' in request.resource.data) || request.resource.data.voidMode == 'rollback')
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidedAt == request.time
          && get(
            /databases/$(database)/documents/branches/$(id)/units/$(resource.data.code)
          ).data.lastEventId == eventId
          && getAfter(
            /databases/$(database)/documents/branches/$(id)/units/$(resource.data.code)
          ).data.lastEventId == resource.data.previousEventId) || (branchEdit(id) && ownImport(id) && ('activityRemoval' in request.resource.data) && removesActivity())) || (signedIn() && profile().role == 'admin' && unlocked(id)
          && !resource.data.voided && request.resource.data.voided == true
          && ('voidMode' in request.resource.data)
          && request.resource.data.voidMode == 'history'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided','voidedBy','voidedAt','voidMode'])
          && request.resource.data.voidedBy == request.auth.uid
          && request.resource.data.voidedAt == request.time);

        allow delete: if false;
      }

      match /activities/{activityId} {
        allow read: if branchAccess(id);

        allow create, update: if branchEdit(id) && (unlocked(id) || ownImport(id))
          && request.resource.data.month.matches(
            '[0-9]{4}-(0[1-9]|1[0-2])'
          )
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.archived is bool
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if branchEdit(id) && ownImport(id) && resource.data.deleting == true
          && get(/databases/$(database)/documents/branches/$(id)).data.importing.operation == 'removeActivity'
          && get(/databases/$(database)/documents/branches/$(id)).data.importing.activityId == activityId;
      }

      match /months/{month} {
    function validRenewTerms(d) {
     let v=d.get('renewByTerm',null);
     return v == null || (d.source == 'import' && v is map
      && v.keys().hasAll(['monthly','quarterly','halfYear','yearly'])
      && v.keys().hasOnly(['monthly','quarterly','halfYear','yearly'])
      && optionalCount(v,'monthly') && optionalCount(v,'quarterly') && optionalCount(v,'halfYear') && optionalCount(v,'yearly')
      && (v.monthly == null || v.quarterly == null || v.halfYear == null || v.yearly == null || !('renew' in d) || d.renew == null
       || v.monthly + v.quarterly + v.halfYear + v.yearly == d.renew));
    }
        function keepsAmounts() {
          return
            !exists(
              /databases/$(database)/documents/branches/$(id)/months/$(month)
            )
            || !('amounts' in resource.data)
            || resource.data.amounts.size() == 0
            || (
              'amounts' in request.resource.data
              && request.resource.data.amounts
                == resource.data.amounts
            );
        }
        allow read: if branchAccess(id);

        allow create, update: if branchEdit(id)
          && (
            unlocked(id)
            || ownImport(id)
          )
          && month.matches(
            '[0-9]{4}-(0[1-9]|1[0-2])'
          )
          && keepsAmounts() && validRenewTerms(request.resource.data)
          && request.resource.data.source in ['live','import']
          && optionalCount(request.resource.data, 'total')
          && optionalCount(request.resource.data, 'rented')
          && optionalCount(request.resource.data, 'new')
          && optionalCount(request.resource.data, 'renew')
          && optionalCount(request.resource.data, 'exit')
          && (
            !('total' in request.resource.data)
            || !('rented' in request.resource.data)
            || request.resource.data.total == null
            || request.resource.data.rented == null
            || request.resource.data.rented
              <= request.resource.data.total
          );

        allow delete: if branchEdit(id)
          && unlocked(id)
          && resource.data.source == 'import';
      }

   function validOtherGoalItem(items,k) {
    let v=items.get(k,null);
    return !(k in items) || (v is map
     && v.keys().hasOnly(['id','name','target'])
     && v.id is string && v.id.matches('[a-zA-Z0-9_-]{1,80}')
     && v.name is string && v.name.size() > 0 && v.name.size() <= 80
     && v.target is number && v.target >= 0 && v.target <= 1000000000);
   }
   function validOtherGoals(items) {
    return items is map && items.keys().hasOnly(['o0', 'o1', 'o2', 'o3', 'o4', 'o5', 'o6', 'o7', 'o8', 'o9'])
     && validOtherGoalItem(items,'o0')
     && validOtherGoalItem(items,'o1')
     && validOtherGoalItem(items,'o2')
     && validOtherGoalItem(items,'o3')
     && validOtherGoalItem(items,'o4')
     && validOtherGoalItem(items,'o5')
     && validOtherGoalItem(items,'o6')
     && validOtherGoalItem(items,'o7')
     && validOtherGoalItem(items,'o8')
     && validOtherGoalItem(items,'o9');
   }
   function validOtherActualItem(items,goals,k) {
    let v=items.get(k,null);
    let g=goals.get(k,null);
    return !(k in items) || (g != null && v is map
     && v.keys().hasOnly(['goalId','value']) && v.goalId == g.id
     && v.value is number && v.value >= 0 && v.value <= 1000000000);
   }
   function validOtherActualValues(items,goals) {
    return items is map && items.keys().hasOnly(['o0', 'o1', 'o2', 'o3', 'o4', 'o5', 'o6', 'o7', 'o8', 'o9'])
     && validOtherActualItem(items,goals,'o0')
     && validOtherActualItem(items,goals,'o1')
     && validOtherActualItem(items,goals,'o2')
     && validOtherActualItem(items,goals,'o3')
     && validOtherActualItem(items,goals,'o4')
     && validOtherActualItem(items,goals,'o5')
     && validOtherActualItem(items,goals,'o6')
     && validOtherActualItem(items,goals,'o7')
     && validOtherActualItem(items,goals,'o8')
     && validOtherActualItem(items,goals,'o9');
   }
   function validOtherActuals(d,month) {
    return !('other' in d) || (d.other is map && d.other.size() == 0)
     || (exists(/databases/$(database)/documents/branches/$(id)/targets/$(month))
       && validOtherActualValues(d.other,get(/databases/$(database)/documents/branches/$(id)/targets/$(month)).data.other));
   }
   match /targets/{period} {
    function validGoal(d) {
     return d.keys().hasOnly(['period','occupancy','performance','referrals','other','revision','updatedBy','updatedAt','changeId'])
      && (!('other' in d) || (validOtherGoals(d.other) && (period.size() == 7 || d.other.size() == 0)))
      && d.period == period && period.matches('20[0-9]{2}(-(0[1-9]|1[0-2]))?')
      && (d.occupancy == null || (positive(d.occupancy) && d.occupancy <= 100))
      && (d.performance == null || positive(d.performance))
      && (d.referrals == null || (d.referrals is int && d.referrals >= 0))
      && d.revision is int && d.revision > 0 && d.changeId is string
      && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function pairedHistory() {
     let h = getAfter(/databases/$(database)/documents/branches/$(id)/targetHistory/$(request.resource.data.changeId)).data;
     return h.period == period && h.next == request.resource.data && h.by == request.auth.uid && h.createdAt == request.time;
    }
    allow read: if branchAccess(id);
    allow create: if globalAccess() && validGoal(request.resource.data) && request.resource.data.revision == 1 && pairedHistory();
    allow update: if globalAccess() && validGoal(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && pairedHistory();
    allow delete: if false;
   }
   match /targetHistory/{changeId} {
    allow read: if branchAccess(id);
    allow create: if globalAccess()
     && request.resource.data.keys().hasOnly(['period','previous','next','by','createdAt'])
     && request.resource.data.by == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.next.changeId == changeId
     && request.resource.data.next == getAfter(/databases/$(database)/documents/branches/$(id)/targets/$(request.resource.data.period)).data
     && ((!exists(/databases/$(database)/documents/branches/$(id)/targets/$(request.resource.data.period)) && request.resource.data.previous == null)
       || (exists(/databases/$(database)/documents/branches/$(id)/targets/$(request.resource.data.period)) && request.resource.data.previous == get(/databases/$(database)/documents/branches/$(id)/targets/$(request.resource.data.period)).data));
    allow update,delete: if false;
   }
   match /referrals/{month} {
    allow read: if branchAccess(id);
    allow create,update: if branchEdit(id)
     && month.matches('20[0-9]{2}-(0[1-9]|1[0-2])') && request.resource.data.month == month
     && request.resource.data.keys().hasOnly(['month','count','entries','updatedBy','updatedAt','targetRevision'])
     && request.resource.data.entries is list && request.resource.data.entries.size() <= 200
     && request.resource.data.count is int && request.resource.data.count == request.resource.data.entries.size()
     && request.resource.data.targetRevision is int && request.resource.data.targetRevision >= 0
     && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    allow delete: if false;
   }
   match /actuals/{month} {
    function validActual(d) {
     return month.matches('20[0-9]{2}-(0[1-9]|1[0-2])') && d.month == month
      && d.keys().hasOnly(['month','occupancy','performance','other','reason','revision','changeId','updatedBy','updatedAt'])
      && (d.occupancy == null || (positive(d.occupancy) && d.occupancy <= 100))
      && (d.performance == null || positive(d.performance))
      && validOtherActuals(d,month)
      && d.reason is string && d.reason.size() <= 500
      && ((d.occupancy == null && d.performance == null) || d.reason.size() > 0)
      && d.revision is int && d.revision > 0 && d.changeId is string
      && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function paired() {
     let h=getAfter(/databases/$(database)/documents/branches/$(id)/actualHistory/$(request.resource.data.changeId)).data;
     return h.month == month && h.next == request.resource.data && h.by == request.auth.uid && h.createdAt == request.time;
    }
    allow read: if branchAccess(id);
    allow create: if branchEdit(id) && validActual(request.resource.data) && request.resource.data.revision == 1 && paired();
    allow update: if branchEdit(id) && validActual(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && paired();
    allow delete: if false;
   }
   match /actualHistory/{changeId} {
    allow read: if branchAccess(id);
    allow create: if branchEdit(id)
     && request.resource.data.keys().hasOnly(['month','previous','next','by','createdAt'])
     && request.resource.data.by == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.next.changeId == changeId
     && request.resource.data.next == getAfter(/databases/$(database)/documents/branches/$(id)/actuals/$(request.resource.data.month)).data
     && ((!exists(/databases/$(database)/documents/branches/$(id)/actuals/$(request.resource.data.month)) && request.resource.data.previous == null)
       || (exists(/databases/$(database)/documents/branches/$(id)/actuals/$(request.resource.data.month)) && request.resource.data.previous == get(/databases/$(database)/documents/branches/$(id)/actuals/$(request.resource.data.month)).data));
    allow update,delete: if false;
   }
      match /imports/{importId} {
        allow read: if branchAccess(id);

        allow create: if branchEdit(id)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

  // storeasy-work-tasks-v1: private branch tasks, immutable audit and text chat
  function workUser() { return activeUser() && profile().role in ['admin','supervisor','manager']; }
  function workAssigned(d,id) {
   let path=/databases/$(database)/documents/workTaskAccess/$(request.auth.uid+'_'+id);
   return exists(path) && get(path).data.active
    && (get(path).data.primaryThread=='main'
      ? request.auth.uid in d.get('directAssigneeIds',[])
      : exists(/databases/$(database)/documents/workTasks/$(id)/items/$(get(path).data.primaryThread))
       && !get(/databases/$(database)/documents/workTasks/$(id)/items/$(get(path).data.primaryThread)).data.deleted
       && request.auth.uid in get(/databases/$(database)/documents/workTasks/$(id)/items/$(get(path).data.primaryThread)).data.get('directAssigneeIds',[]));
  }
  function workScope(d,id) {
   return workUser() && (globalAccess() || d.branchIds.hasAny(profile().branchIds) || workAssigned(d,id));
  }
  function workWriteScope(id) {
   return workScope(workAfter(id),id) || (exists(/databases/$(database)/documents/workTasks/$(id)) && workScope(workRoot(id),id));
  }
  function workRoot(id) { return get(/databases/$(database)/documents/workTasks/$(id)).data; }
  function workAfter(id) { return getAfter(/databases/$(database)/documents/workTasks/$(id)).data; }
  function workLog(id) { let r=workAfter(id);return getAfter(/databases/$(database)/documents/workTasks/$(id)/history/$(r.lastActionId)).data; }
  function workVersion(id) { let r=workAfter(id);return getAfter(/databases/$(database)/documents/workTasks/$(id)/versions/$(r.lastActionId)).data; }
  function workPaired(id) { let a=workLog(id);return a.actor==request.auth.uid && a.actorName==profile().username && a.at==request.time && a.revision==workAfter(id).revision; }
  function workFields(d) {
   return d.title is string && d.title.size()>0 && d.title.size()<=120
    && d.description is string && d.description.size()<=5000
    && d.assignee is string && d.assignee.size()<=80
    && (!('directAssigneeIds' in d) || (d.directAssigneeIds is list && d.directAssigneeIds.size()<=100 && d.directAssigneeIds.toSet().size()==d.directAssigneeIds.size()))
    && d.due is string && (d.due=='' || d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
    && d.priority in ['normal','urgent'] && d.done is bool && d.deleted is bool
    && ((!d.done && d.completedBy==null && d.completedName==null && d.completedAt==null)
      || (d.done && d.completedBy is string && d.completedName is string && d.completedAt is timestamp));
  }
  match /workTasks/{id} {
   function localLog() { return getAfter(/databases/$(database)/documents/workTasks/$(id)/history/$(request.resource.data.lastActionId)).data; }
   function localVersion() { return getAfter(/databases/$(database)/documents/workTasks/$(id)/versions/$(request.resource.data.lastActionId)).data; }
   function localPaired() { let a=localLog();return a.actor==request.auth.uid && a.actorName==profile().username && a.at==request.time && a.revision==request.resource.data.revision; }
   function validRoot(d) {
    return d.keys().hasOnly(['title','description','assignee','directAssigneeIds','due','priority','done','deleted','completedBy','completedName','completedAt','branchIds','branchNames','mode','childCount','openChildren','revision','createdBy','createdName','createdAt','updatedAt','lastActionId','signals'])
     && workFields(d) && d.branchIds is list && d.branchIds.size()>0 && d.branchIds.size()<=100
     && d.branchIds.toSet().size()==d.branchIds.size() && d.branchNames is map && d.branchNames.keys().hasOnly(d.branchIds) && d.branchNames.keys().hasAll(d.branchIds)
     && d.mode in ['single','shared'] && (d.mode=='shared' || d.branchIds.size()==1)
     && d.childCount is int && d.childCount>=0 && d.childCount<=100
     && d.openChildren is int && d.openChildren>=0 && d.openChildren<=d.childCount
     && (!d.done || d.openChildren==0) && d.revision is int && d.revision>=0 && d.lastActionId is string && d.signals is map;
   }
   function metadataSame() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title','description','assignee','directAssigneeIds','due','priority']); }
   function completionSame() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['done','completedBy','completedName','completedAt']); }
   function validSignal() {
    let a=localLog();let n=request.resource.data.signals;let o=resource.data.signals;
    let previous=a.thread in o ? o[a.thread] : {};
    return n.keys().hasAll(o.keys()) && n.diff(o).affectedKeys().hasOnly([a.thread])
     && n[a.thread] is map && n[a.thread].keys().hasAll(previous.keys())
     && n[a.thread].diff(previous).affectedKeys().hasOnly([request.auth.uid]) && n[a.thread][request.auth.uid]==request.time;
   }
   function countersSame() { return request.resource.data.childCount==resource.data.childCount && request.resource.data.openChildren==resource.data.openChildren; }
   function childOperation() {
    let a=localLog();let n=request.resource.data;let o=resource.data;
    let child=getAfter(/databases/$(database)/documents/workTasks/$(id)/items/$(a.thread)).data;
    let before=localVersion().before;
    return a.thread!='main' && a.targetId==a.thread && child==localVersion().after
     && metadataSame() && n.deleted==o.deleted
     && (a.action=='addItem' || before==get(/databases/$(database)/documents/workTasks/$(id)/items/$(a.thread)).data)
     && (
      (a.action=='addItem' && before==null && !exists(/databases/$(database)/documents/workTasks/$(id)/items/$(a.thread)) && !child.done && !child.deleted
       && n.childCount==o.childCount+1 && n.openChildren==o.openChildren+1 && !n.done)
      || (a.action=='edit' && countersSame() && completionSame())
      || (a.action=='complete' && before.deleted==false && child.deleted==false && before.done!=child.done
       && n.childCount==o.childCount && n.openChildren==o.openChildren+(child.done ? -1 : 1)
       && (child.done ? completionSame() : !n.done))
      || (a.action in ['itemDelete','itemRestore'] && before.done==child.done && before.deleted!=child.deleted
       && n.childCount==o.childCount && n.openChildren==o.openChildren+(child.done ? 0 : child.deleted ? -1 : 1)
       && (a.action=='itemDelete' ? child.deleted && completionSame() : globalAccess() && !child.deleted && (child.done ? completionSame() : !n.done)))
     );
   }
   function messageOperation() {
    let a=localLog();let v=localVersion();let path=/databases/$(database)/documents/workTasks/$(id)/threads/$(a.thread)/messages/$(a.targetId);
    return existsAfter(path) && getAfter(path).data==v.after
     && (a.action=='message' ? !exists(path) && v.before==null : exists(path) && get(path).data==v.before);
   }
   function operation() {
    let a=localLog();let n=request.resource.data;let o=resource.data;
    return (
     (a.action in ['message','messageEdit','messageDelete'] && messageOperation() && !o.deleted && n.deleted==o.deleted && metadataSame() && completionSame() && countersSame())
     || (a.thread=='main' && localVersion().before==o && localVersion().after==n && countersSame()
      && ((a.action=='edit' && !o.deleted && n.deleted==o.deleted && completionSame())
       || (a.action=='complete' && !o.deleted && n.deleted==o.deleted && metadataSame() && n.done!=o.done
        && (n.done ? n.completedBy==request.auth.uid && n.completedName==profile().username && n.completedAt==request.time : true))
       || (a.action=='delete' && !o.deleted && n.deleted && metadataSame() && completionSame())
       || (a.action=='restore' && globalAccess() && o.deleted && !n.deleted && metadataSame() && completionSame())))
     || (!o.deleted && childOperation())
    );
   }
   allow read: if workScope(resource.data,id);
   allow create: if workUser() && validRoot(request.resource.data)
    && (globalAccess() || profile().branchIds.hasAll(request.resource.data.branchIds))
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdName==profile().username
    && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time
    && request.resource.data.revision==0 && request.resource.data.childCount==0 && request.resource.data.openChildren==0 && !request.resource.data.done && !request.resource.data.deleted
    && request.resource.data.signals=={'main': {request.auth.uid:request.time}}
    && localPaired() && localLog().action=='create' && localLog().thread=='main'
    && localVersion().before==null && localVersion().after==request.resource.data;
   allow update: if workScope(resource.data,id) && validRoot(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','assignee','directAssigneeIds','due','priority','done','deleted','completedBy','completedName','completedAt','childCount','openChildren','revision','updatedAt','lastActionId','signals'])
    && request.resource.data.revision==resource.data.revision+1 && request.resource.data.updatedAt==request.time
    && !exists(/databases/$(database)/documents/workTasks/$(id)/history/$(request.resource.data.lastActionId))
    && localPaired() && validSignal() && operation();
   allow delete: if false;
   match /history/{actionId} {
    allow read: if workScope(workRoot(id),id) && (!workRoot(id).deleted || globalAccess());
    allow create: if workWriteScope(id) && workAfter(id).lastActionId==actionId && workPaired(id)
     && request.resource.data.keys().hasOnly(['action','thread','actor','actorName','at','revision','targetId','done'])
     && request.resource.data.action in ['create','edit','complete','addItem','delete','restore','itemDelete','itemRestore','message','messageEdit','messageDelete']
     && request.resource.data.thread is string && request.resource.data.targetId is string
     && request.resource.data.done==(request.resource.data.action=='complete' ? workVersion(id).after.done : null)
     && existsAfter(/databases/$(database)/documents/workTasks/$(id)/versions/$(actionId));
    allow update,delete: if false;
   }
   match /versions/{actionId} {
    allow read: if globalAccess();
    allow create: if workWriteScope(id) && workAfter(id).lastActionId==actionId && workPaired(id)
     && request.resource.data.keys().hasOnly(['before','after']);
    allow update,delete: if false;
   }
   match /items/{itemId} {
    function pairedItem() { let a=workLog(id);return workPaired(id) && a.thread==itemId && a.targetId==itemId && workVersion(id).after==request.resource.data; }
    function validItem(d) { return d.keys().hasOnly(['title','description','assignee','directAssigneeIds','due','priority','done','deleted','completedBy','completedName','completedAt','createdBy','createdName','createdAt']) && workFields(d); }
    allow read: if workScope(workRoot(id),id) && (!workRoot(id).deleted || globalAccess());
    allow create: if workScope(workRoot(id),id) && !workRoot(id).deleted && validItem(request.resource.data) && pairedItem() && workLog(id).action=='addItem'
     && workVersion(id).before==null && !request.resource.data.done && !request.resource.data.deleted
     && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdName==profile().username && request.resource.data.createdAt==request.time;
    allow update: if workScope(workRoot(id),id) && !workRoot(id).deleted && validItem(request.resource.data) && pairedItem() && workVersion(id).before==resource.data
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','assignee','directAssigneeIds','due','priority','done','deleted','completedBy','completedName','completedAt'])
     && ((workLog(id).action=='edit' && !resource.data.deleted && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','assignee','directAssigneeIds','due','priority']))
      || (workLog(id).action=='complete' && !resource.data.deleted && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','completedBy','completedName','completedAt'])
       && (request.resource.data.done ? request.resource.data.completedBy==request.auth.uid && request.resource.data.completedName==profile().username && request.resource.data.completedAt==request.time : true))
      || (workLog(id).action in ['itemDelete','itemRestore'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) && (workLog(id).action=='itemRestore' ? globalAccess() : true)));
    allow delete: if false;
   }
   match /threads/{thread}/messages/{messageId} {
    function allowedThread() { return thread=='main' || (!get(/databases/$(database)/documents/workTasks/$(id)/items/$(thread)).data.deleted); }
    function pairedMessage() { let a=workLog(id);return workPaired(id) && a.thread==thread && a.targetId==messageId && workVersion(id).after==request.resource.data; }
    function validMessage(d) { return d.keys().hasOnly(['text','author','authorName','createdAt','edited','deleted','editedAt','deletedAt']) && d.text is string && d.text.size()<=5000 && (d.deleted || d.text.size()>0) && d.edited is bool && d.deleted is bool; }
    allow read: if workScope(workRoot(id),id) && ((!workRoot(id).deleted && allowedThread()) || globalAccess());
    allow create: if workScope(workRoot(id),id) && !workRoot(id).deleted && allowedThread() && pairedMessage() && validMessage(request.resource.data)
     && workLog(id).action=='message' && workVersion(id).before==null && !request.resource.data.edited && !request.resource.data.deleted
     && request.resource.data.author==request.auth.uid && request.resource.data.authorName==profile().username && request.resource.data.createdAt==request.time
     && !('editedAt' in request.resource.data) && !('deletedAt' in request.resource.data);
    allow update: if workScope(workRoot(id),id) && !workRoot(id).deleted && allowedThread() && pairedMessage() && validMessage(request.resource.data)
     && workVersion(id).before==resource.data && resource.data.author==request.auth.uid && !resource.data.deleted
     && ((workLog(id).action=='messageEdit' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt']) && request.resource.data.edited && request.resource.data.editedAt==request.time)
      || (workLog(id).action=='messageDelete' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','deleted','deletedAt']) && request.resource.data.deleted && request.resource.data.text=='' && request.resource.data.deletedAt==request.time));
    allow delete: if false;
   }
  }
  match /workTaskAccess/{accessId} {
   function targetIds(d) {
    return d==null || d.deleted ? [] : d.get('directAssigneeIds',[]);
   }
   function nodeBefore(id,a) {
    return a.action in ['create','addItem'] ? null : a.thread=='main' ? workRoot(id) : get(/databases/$(database)/documents/workTasks/$(id)/items/$(a.thread)).data;
   }
   function nodeAfter(id,a) {
    return a.thread=='main' ? workAfter(id) : getAfter(/databases/$(database)/documents/workTasks/$(id)/items/$(a.thread)).data;
   }
   function validAccess() {
    let d=request.resource.data;
    let a=workLog(d.taskId);
    let old=resource==null ? [] : resource.data.sources;
    let was=d.uid in targetIds(nodeBefore(d.taskId,a));
    let now=d.uid in targetIds(nodeAfter(d.taskId,a));
    return d.keys().hasOnly(['uid','taskId','sources','primaryThread','active','updatedBy','updatedAt','lastActionId'])
     && d.uid is string && d.uid.size()>0 && d.uid.size()<=128 && d.uid.matches('[a-zA-Z0-9_-]+')
     && d.taskId is string && accessId==d.uid+'_'+d.taskId
     && d.sources is list && d.sources.size()<=101 && d.sources.toSet().size()==d.sources.size()
     && d.active==(d.sources.size()>0) && (d.active ? d.primaryThread in d.sources : d.primaryThread=='')
     && d.updatedBy==request.auth.uid && d.updatedAt==request.time && d.lastActionId==workAfter(d.taskId).lastActionId
     && a.action in ['create','edit','addItem','itemDelete','itemRestore'] && workPaired(d.taskId)
     && was==(a.thread in old) && was!=now
     && (now ? d.sources.toSet()==old.toSet().union([a.thread].toSet()) : d.sources.toSet()==old.toSet().difference([a.thread].toSet()));
   }
   allow get: if workUser() && (!exists(/databases/$(database)/documents/workTaskAccess/$(accessId)) || globalAccess() || resource.data.uid==request.auth.uid || workScope(workRoot(resource.data.taskId),resource.data.taskId));
   allow list: if workUser() && (globalAccess() || resource.data.uid==request.auth.uid);
   allow create,update: if workUser() && workWriteScope(request.resource.data.taskId) && validAccess();
   allow delete: if false;
  }
  match /workPeople/{uid} {
   allow read: if workUser() || (signedIn() && uid==request.auth.uid);
   allow create,update: if signedIn() && (globalAccess() || uid==request.auth.uid)
    && request.resource.data.keys().hasOnly(['username'])
    && request.resource.data.username is string && request.resource.data.username.size()>0 && request.resource.data.username.size()<=32
    && existsAfter(/databases/$(database)/documents/users/$(uid))
    && request.resource.data.username==getAfter(/databases/$(database)/documents/users/$(uid)).data.username;
   allow delete: if globalAccess() && !existsAfter(/databases/$(database)/documents/users/$(uid));
  }
  match /workReads/{receiptId} {
   allow get: if workUser() && (!exists(/databases/$(database)/documents/workReads/$(receiptId)) || resource.data.uid==request.auth.uid);
   allow list: if workUser() && resource.data.uid==request.auth.uid;
   allow create,update: if workUser() && request.resource.data.uid==request.auth.uid
    && receiptId==request.auth.uid+'_'+request.resource.data.taskId
    && request.resource.data.keys().hasOnly(['uid','taskId','seen']) && request.resource.data.seen is map && request.resource.data.seen.size()<=101
    && workScope(workRoot(request.resource.data.taskId),request.resource.data.taskId);
   allow delete: if false;
  }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}

